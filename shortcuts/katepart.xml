<!-- Kate++ shortcut overrides for the editor (component "katepart"). Notepad++ habits. -->
<overrides component="katepart" file="katepart5ui.rc">
  <Action name="edit_replace" shortcut="Ctrl+H; Ctrl+R"/>
  <Action name="tools_scripts_duplicateLinesDown" shortcut="Ctrl+D; Ctrl+Alt+Down"/>
  <Action name="tools_comment" shortcut="Ctrl+K"/>
  <Action name="tools_uncomment" shortcut="Ctrl+Shift+K"/>
  <Action name="tools_toggle_comment" shortcut="Ctrl+Q; Ctrl+/"/>
  <Action name="delete_line" shortcut="Ctrl+Shift+L"/>
  <Action name="tools_lowercase" shortcut="Ctrl+U"/>
  <Action name="tools_uppercase" shortcut="Ctrl+Shift+U"/>
  <!-- frees Ctrl+T for "new tab"; Transpose Characters stays in Edit menu / command bar -->
  <Action name="transpose_char" shortcut=""/>
</overrides>
