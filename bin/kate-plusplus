#!/usr/bin/env python3
"""Kate++ — Notepad++ comfort for Kate.  Run `kate-plusplus --help`."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

if sys.version_info < (3, 9):
    sys.exit("Kate++ needs Python 3.9 or newer.")

from kpp.cli import main  # noqa: E402

try:
    sys.exit(main() or 0)
except KeyboardInterrupt:
    print()
    sys.exit(130)
